[Unit]
Description=Start ImpulseLoader after jack has started
Wants=start-jack.service

[Service]
Type=simple
User=tymo
Group=audio
CapabilityBoundingSet=CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_NICE
ExecStartPre=/bin/sh -c 'until jack_wait -w -t 1; do sleep 1; done'
ExecStart=/home/tymo/start-ir.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target

